{
  "name": "aura-windows-voice-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AURA local-first Windows voice assistant with allowlisted actions and audit logging",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/agent.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "zod": "^3.25.76",
    "@google/genai": "^1.30.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
